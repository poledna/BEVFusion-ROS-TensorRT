<launch>
    <!-- model_name: resnet50/resnet50int8/swint -->
    <!-- precision: fp16/int8 -->
    <param name="model_name" type="string" value="resnet50int8" />
    <param name="precision" type="string" value="int8" />

    <!-- ros topic name -->
    <param name="topic_cloud"  type="string" value="/invz_summation_reflection" />
    <param name="topic_img_f"  type="string" value="/camera/image_color" />

    <!-- bevfusion node -->
    <node pkg="bevfusion" name="bevfusion_node" type="bevfusion_node" output="screen" />
    
    <!-- rviz -->
    <node pkg="rviz" name ="rviz_bevfusion_node" type="rviz"
        respawn="false" output="screen" args="-d $(find bevfusion)/launch/1.rviz"/>
</launch>
